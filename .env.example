# Copy to .env. Pin the n8n image to a tested version before deployment.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_PORT=5678
# Store the Automation API token in an n8n Header Auth credential.
# API URL inside n8n: http://host.docker.internal:3434

# Optional database (only with --profile postgres|mysql|mssql).
DB_NAME=flowweb
DB_USER=flowweb
# SQL Server needs a strong password (8+ chars, upper/lower/digit/symbol); user is "sa".
DB_PASSWORD=change-me-Str0ng!
DB_ROOT_PASSWORD=change-me-too-Str0ng!
POSTGRES_PORT=5432
MYSQL_PORT=3306
MSSQL_PORT=1433

# pgadmin
PGADMIN_EMAIL=your-email@domain.com
PGADMIN_PASSWORD=your_pgadmin_password_here
